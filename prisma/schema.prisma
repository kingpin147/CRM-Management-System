generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String     @id @default(uuid())
  supabaseId String     @unique
  fullName   String
  email      String     @unique
  role       Role
  designation String?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  customers  Customer[] @relation("CustomerAccountExecutive")
  assignedJobs Customer[] @relation("CustomerAssignedInstaller")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SALES_MANAGER
  BILLING_MANAGER
  OM_MANAGER
  SALES
  INSTALLATION
  CUSTOMER_SUPPORT
}

model Customer {
  id             String         @id @default(uuid())
  customerCode   String         @unique
  fullName       String
  customerType   CustomerType
  contactNumber  String
  pocNumber      String?
  email          String?
  cnic           String         @unique
  cnicExpiry     DateTime?
  crfNumber      String?        @unique // Auto-generated at signup submission
  status         CustomerStatus
  activationDate DateTime?
  signupDate     DateTime?
  address        String
  houseNumber    String?
  streetNumber   String?
  block          String?
  subArea        String?
  area           String?
  city           String
  country        String         @default("Pakistan")
  coordinates    String?
  cnicFrontUrl   String?
  cnicBackUrl    String?
  solarSystem    SolarSystem?
  packagePlan    PackagePlan?
  tickets        Ticket[]
  transactions   Transaction[]
  invoices       Invoice[]
  ledgerEntries  LedgerEntry[]
  customerHistory CustomerHistory[]
  communicationLogs CommunicationLog[]

  accountExecutiveId String?
  accountExecutive   User?   @relation("CustomerAccountExecutive", fields: [accountExecutiveId], references: [id])

  assignedInstallerId String?
  assignedInstaller   User?   @relation("CustomerAssignedInstaller", fields: [assignedInstallerId], references: [id])
}

enum CustomerType {
  RESIDENTIAL
  CORPORATE
  INDUSTRIAL
  TEMPORARY_BLOCKED
  TERMINATED
}

enum CustomerStatus {
  SIGNUP_GENERATED
  PENDING_PAYMENT_VERIFICATION
  PENDING_ACTIVATION
  CONNECTION_ACTIVE
  NON_PAYMENT_BLOCKED
  TEMPORARY_BLOCKED
  PERMANENT_DISCONNECTION
  FOC_CONNECTION
  IN_HOUSE_CONNECTION
}

model SolarSystem {
  id                     String    @id @default(uuid())
  customerId             String    @unique
  customer               Customer  @relation(fields: [customerId], references: [id])
  disco                  String? // LESCO, etc.
  discoRefNo             String? // DISCO Reference Number / Consumer ID
  meterType              String // Green Meter, Non Green
  meterPhase             String? // Single Phase, Three Phase
  zeroExportDevice       Boolean
  inverterBrand          String
  inverterType           String // Hybrid, OnGrid, Hybrid+OnGrid
  inverterPhase          String // Single, Three
  inverterCategory       String // High Voltage, Low Voltage
  inverterSize           String? // 6kW
  noOfInverters          Int
  inverterSerial         String
  inverterSerials        String[]  @default([])
  inverterWarrantyEnd    DateTime?
  inverterWarrantyEnds   DateTime[] @default([])
  panelBrand             String
  panelType              String // Monofacial, Bifacial
  panelTechnology        String // Mono Perc, Topcon, HJT, ABC, HIBC, etc.
  panelWattage           Int
  noOfPanels             Int
  totalWattage           Int
  panelWarrantyEnd       DateTime?
  batteryCategory        String // High Voltage, Low Voltage
  batteryType            String // Lithium, Tubular, Lead Acid, Dry
  batteryBrand           String
  noOfBatteries          Int
  batterySerial          String
  batterySerials         String[]  @default([])
  batteryWarrantyEnd     DateTime?
  batteryWarrantyEnds    DateTime[] @default([])
  earthing               String // AC, DC, Both
  earthingLastCheck      DateTime?
  earthingAcOhms         Decimal?
  earthingDcOhms         Decimal?
  lightningProtection    Boolean
  breakerName            String
  ingressProtection      String? // 20, 65, 67, etc.
  structureType          String? // Elevated, Standard, etc.
  structureMaterial      String? // Painted, Aluminium, Hot Dip Galvanized, etc.
  systemInstallationDate DateTime?
  installerName          String?
  installerCompany       String?
  installerAddress       String?
  installerContact       String?
  installerEmail         String?
  lastAuditDate          DateTime?
  inverterStatus         String? // Excellent, Good, Fair, etc.
  panelStatus            String?
  batteryStatus          String?
  structureStatus        String?
  cableStatus            String?
  earthingStatus         String?
  breakerStatus          String?
  inverterImages         String[]  @default([])
  batteryImages          String[]  @default([])
}

model PackagePlan {
  id               String    @id @default(uuid())
  customerId       String    @unique
  customer         Customer  @relation(fields: [customerId], references: [id])
  systemSizeKw     String // 1-10 kW, 10-20 kW, 20-30 kW, 30+ kW (Dropdown)
  packageTier      String // Basic, Moderate, Comprehensive (Dropdown)
  billingType      String // Monthly, Quarterly, Half Yearly, Yearly, FOC (Dropdown)
  monitoringTime   String // 12 Hours, 24 Hours (Dropdown)
  nextBillingDate  DateTime?
  monthlyBasePrice Decimal
  appliedDiscount  Decimal // 0%, 10%, 20%, 40%, 100% (FOC)
  salesTaxAmount   Decimal
  totalAmount      Decimal
}

model Ticket {
  id                  String          @id @default(uuid())
  ticketNumber        String          @unique
  customerId          String
  customer            Customer        @relation(fields: [customerId], references: [id])
  ticketType          TicketType // Technical, Billing, Service Request
  source              String // UAN, Email, Whatsapp, Escalation
  assignedTo          String // O&M, Billing, Sales, Customer Support
  escalation          String // Level-1, Level-2, Level-3
  status              TicketStatus // Pending, Resolved, Canceled, OnHold, Closed
  actionPriority      String? // High, Medium, Low
  firstCallResolution Boolean         @default(false)
  category            String // Inverter, Panel, Battery, Breaker (if Technical)
  subCategory         String? // Brands or specific types
  fault               String? // (01) BatVolLow, (02) BatOverCurrSw, etc.
  description         String
  attachmentUrl       String?
  createdAt           DateTime        @default(now())
  histories           TicketHistory[]

  @@index([customerId])
  @@index([status])
  @@index([assignedTo])
}

model TicketHistory {
  id         String       @id @default(uuid())
  ticketId   String
  ticket     Ticket       @relation(fields: [ticketId], references: [id])
  status     TicketStatus
  department String
  remarks    String?
  createdBy  String // User name or ID
  createdAt  DateTime     @default(now())
  timeInDept String? // Duration spent in department

  @@index([ticketId])
}

enum TicketType {
  TECHNICAL_COMPLAINT
  BILLING_COMPLAINT
  SERVICE_REQUEST
}

enum TicketStatus {
  PENDING
  RESOLVED
  CANCELED
  ON_HOLD
  CLOSED
}

model Transaction {
  id            String   @id @default(uuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  amount        Decimal
  paymentMethod String
  status        String
  createdAt     DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  billingPeriod DateTime // The month/period this invoice is for
  amount        Decimal
  salesTax      Decimal
  totalAmount   Decimal
  status        String // Unpaid, Paid, Overdue
  dueDate       DateTime
  createdAt     DateTime      @default(now())
  ledgerEntries LedgerEntry[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model LedgerEntry {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  invoiceId  String?
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  date       DateTime @default(now())
  refNumber  String? // Receipt or Invoice #
  narration  String
  debit      Decimal  @default(0)
  credit     Decimal  @default(0)
  balance    Decimal
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
}

model CustomerHistory {
  id           String          @id @default(uuid())
  customerId   String?
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerCode String
  customerName String
  actionType   String          // STATUS_CHANGE, PACKAGE_CHANGE, SIGNUP, DISCONNECTION, REINSTATED, DELETED
  oldStatus    CustomerStatus?
  newStatus    CustomerStatus?
  oldPackage   String?
  newPackage   String?
  notes        String?
  performedBy  String?
  createdAt    DateTime        @default(now())

  @@index([customerId])
  @@index([createdAt])
  @@index([customerCode])
}

model CommunicationLog {
  id           String    @id @default(uuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel      String    // "SMS" | "EMAIL"
  type         String    // "INVOICE", "DUE_REMINDER", "OVERDUE_REMINDER", "MANUAL", "INVITATION"
  recipient    String    // phone number or email address
  subject      String?   // email subject (null for SMS)
  messageBody  String    // the actual message/content summary
  status       String    @default("SENT") // SENT, DELIVERED, OPENED, FAILED, UNDELIVERED
  externalId   String?   // SendPK message ID or Brevo message ID
  invoiceId    String?   // linked invoice ID if applicable
  errorDetails String?   // error details if any
  sentAt       DateTime  @default(now())
  deliveredAt  DateTime?
  openedAt     DateTime?
  createdAt    DateTime  @default(now())

  @@index([customerId])
  @@index([channel])
  @@index([createdAt])
}
